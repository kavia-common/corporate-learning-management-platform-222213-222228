# Django backend environment configuration (copy to .env and adjust as needed)

# Core
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (choose one approach)
# Option A: SQLite (default)
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Option B: DATABASE_URL example values
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=mysql://user:password@host:3306/dbname

# CORS / Proxy
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
USE_X_FORWARDED_HOST=true
X_FRAME_OPTIONS=ALLOWALL

# Email (console backend used when DJANGO_DEBUG=true)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.com

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
JWT_ALGORITHM=HS256

# Frontend integration (for docs/reference)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime binding
# Some hosting providers pass PORT; runserver ignores PORT unless you use it in your start command.
# For local dev we bind explicitly to 0.0.0.0:3001.
PORT=3001
