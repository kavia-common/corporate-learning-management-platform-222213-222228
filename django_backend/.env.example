# Django core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.kavia.ai

# Database (choose one of the following approaches)

# 1) Unified URL (recommended; supports sqlite/postgres/mysql)
# Examples:
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:pass@localhost:5432/lms
# DATABASE_URL=mysql://user:pass@localhost:3306/lms
DATABASE_URL=

# 2) Or engine-specific variables (fallback if DATABASE_URL is empty)
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.com

# Media
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=./media

# CORS / Proxy
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
USE_X_FORWARDED_HOST=true
X_FRAME_OPTIONS=ALLOWALL

# Frontend/Integration runtime environment (documented for consistency)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=0
REACT_APP_PORT=3001
REACT_APP_TRUST_PROXY=1
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/api/health/
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=0
